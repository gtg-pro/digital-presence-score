# Server-only secrets — never expose to the browser (no NEXT_PUBLIC_ for these).
OPENAI_API_KEY=

# Optional model override (default: gpt-4o-mini). Prefer a model that supports
# OpenAI Responses API web_search for actual public website retrieval.
OPENAI_MODEL=gpt-4o-mini

# Short-lived encrypted cookie transport for live report sessions.
# REQUIRED in production. Do not reuse provider API keys as this secret.
REPORT_SESSION_SECRET=

# Cookie Secure attribute: defaults to true when NODE_ENV=production.
# Only set COOKIE_SECURE=0 for local plain-HTTP `next start` / Playwright.
# Keep Secure enabled on real HTTPS production hosts.
# COOKIE_SECURE=0

# Recommended for production Node hosts receiving chunked report cookies:
# NODE_OPTIONS=--max-http-header-size=65536
# (also applied by `npm start` in this repo)

# Playwright E2E only — NEVER enable on real production traffic.
# Disabled unless explicitly set to 1.
# ALLOW_AUDIT_E2E_FIXTURES=1
# AUDIT_E2E_FIXTURE=complete

# Optional Chromium launch overrides for PDF/PNG export (server-only).
# PLAYWRIGHT_EXECUTABLE_PATH=/absolute/path/to/chromium
# FORCE_SERVERLESS_CHROMIUM=1
# FORCE_LOCAL_CHROMIUM=1
